FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies for image processing
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy model files
COPY server/app/model/*.h5 app/model/

# Copy application code
COPY server/app/ ./app/

# Copy metrics and samples files for Cloud Run in-memory filesystem
# These will be copied to /tmp at startup
COPY client/public/metrics /app/data/metrics
COPY client/public/samples /app/data/samples

# Copy startup script
COPY server/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Expose port
EXPOSE 8000

# Run the application using startup script (handles Cloud Run /tmp setup)
CMD ["/app/start.sh"]

